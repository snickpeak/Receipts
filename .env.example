# Copy to .env in this directory (artifacts/mobile/) and fill in values.
# `.env` must be a FILE (not a folder) or Expo (@expo/env) will not load it.
# https://docs.expo.dev/guides/environment-variables/
#
# Only names prefixed EXPO_PUBLIC_ are exposed in the JS bundle.

# Required for Clerk auth (see app/_layout.tsx): one-line Clerk publishable key pk_test_/pk_live_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: Clerk proxy URL
# EXPO_PUBLIC_CLERK_PROXY_URL=

# Backend host for native builds (no scheme). Web uses same-origin /api.
EXPO_PUBLIC_DOMAIN=

# Optional: used by scripts/build.js for Replit-style deploys
# EXPO_PUBLIC_REPL_ID=

# RevenueCat public SDK keys (see lib/revenuecat.tsx)
# Dev / TestFlight: only EXPO_PUBLIC_REVENUECAT_TEST_API_KEY is required.
# Store production: set EXPO_PUBLIC_REVENUECAT_IOS_API_KEY and/or EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY.
# EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
