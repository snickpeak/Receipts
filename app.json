{
  "expo": {
    "name": "Receipts",
    "slug": "mobile",
    "owner": "astrohaile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "receiptsapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.receiptsapp.journal",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Receipts uses Face ID to protect your private journal entries with biometric authentication.",
        "NSCameraUsageDescription": "Receipts uses your camera to attach photos and optionally read visible text (on-device) into your entry notes.",
        "NSPhotoLibraryUsageDescription": "Receipts accesses your photo library so you can attach images to journal entries.",
        "NSLocationWhenInUseUsageDescription": "Receipts uses your location to automatically tag where a journal entry was written.",
        "NSMicrophoneUsageDescription": "Receipts uses the microphone to record voice memos you attach to journal entries.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "backgroundColor": "#0a0a0a",
      "package": "com.receiptsapp.journal",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Receipts uses Face ID to protect your private journal entries with biometric authentication."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Receipts accesses your photo library so you can attach images to journal entries.",
          "cameraPermission": "Receipts uses your camera to attach photos and optionally read visible text on-device into notes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Receipts uses your location to automatically tag where a journal entry was written."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#a855f7",
          "sounds": []
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "335eab2c-45dd-492e-b143-bfa03556835e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/335eab2c-45dd-492e-b143-bfa03556835e"
    }
  }
}
